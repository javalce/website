---
import Hero from '@/components/hero.astro';
import ProjectList from '@/components/project-list.astro';
import SectionContainer from '@/components/section-container.astro';
import TitleSection from '@/components/title-section.astro';
import { relevantPersonalProjects, relevantProfessionalProjects } from '@/data/projects';
import Layout from '@/layouts/layout.astro';
---

<Layout>
  <SectionContainer class='py-16 md:py-36'>
    <Hero />
  </SectionContainer>
  <div class='space-y-24'>
    {relevantProfessionalProjects.length > 0 && (
      <SectionContainer>
        <TitleSection>Proyectos profesionales</TitleSection>
        <ProjectList projects={relevantProfessionalProjects} />
      </SectionContainer>
    )}
    {relevantPersonalProjects.length > 0 && (
      <SectionContainer>
        <TitleSection>Proyectos personales</TitleSection>
        <ProjectList projects={relevantPersonalProjects} />
      </SectionContainer>
    )}
  </div>
  <!-- <section class='grid w-full grid-cols-3 grid-rows-2 gap-2'>
      <Intro class='col-span-2 animate-fade-in-up delay-0' />
      <About class='col-span-1 row-span-2 animate-fade-in-up delay-300' />
      <Experience class='col-span-1 row-span-1 animate-fade-in-up delay-400' />
      <Projects class='col-span-1 row-span-1 animate-fade-in-up delay-200' />
      <TechnologiesSlider class='col-span-3 row-span-1 animate-fade-in-up delay-500' />
      </section> -->
</Layout>
