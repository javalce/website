---
import Hero from '@/components/hero.astro';
import MoveRightIcon from '@/components/icons/move-right-icon.astro';
import ProjectList from '@/components/project-list.astro';
import SectionContainer from '@/components/section-container.astro';
import TitleSection from '@/components/title-section.astro';
import { Button } from '@/components/ui/button';
import { relevantProjects } from '@/data/projects';
import Layout from '@/layouts/layout.astro';
---

<Layout>
  <SectionContainer class='py-16 md:py-36'>
    <Hero />
  </SectionContainer>
  <div class='space-y-24'>
    {relevantProjects.length > 0 && (
      <SectionContainer>
        <TitleSection>Proyectos</TitleSection>
        <ProjectList projects={relevantProjects} />
        <Button href='/projects' variant='link' class='mt-4'>
          Ver más <MoveRightIcon />
        </Button>
      </SectionContainer>
    )}
  </div>
</Layout>
