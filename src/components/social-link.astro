---
import type { HTMLAttributes } from 'astro/types';

import { Button } from './ui/button';

interface Props extends HTMLAttributes<'a'> {
  name: string;
}

const { class: className, name, ...rest } = Astro.props;
---

<Button
  class={className}
  variant='outline'
  target='_blank'
  rel='noopener noreferrer'
  aria-label={name}
  as='a'
  {...rest}
>
  <slot />
</Button>
