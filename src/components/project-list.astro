---
import GitHubIcon from '@/components/icons/github-icon.astro';
import { projects } from '@/data/projects';

import ExternalLinkIcon from './icons/external-link-icon.astro';
import Button from './ui/button.astro';
---

<div class='flex flex-col gap-y-16'>
  {projects.map(({ name, description, image, github, link }) => (
    <article class='flex flex-col space-x-0 space-y-6 group md:flex-row md:space-x-10 md:space-y-0'>
      <div class='w-full md:w-1/2'>
        <div class='relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition-all duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl md:group-hover:-translate-y-1 dark:md:group-hover:shadow-[0_20px_60px_-10px_rgba(59,130,246,0.2)] md:group-hover:shadow-[0_20px_60px_-10px_rgba(59,130,246,0.8)] lg:border lg:border-border lg:hover:border-border/30 lg:hover:bg-primary/50'>
          <img
            src={image}
            alt={name}
            class='object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105'
          />
          <div
            aria-hidden='true'
            class='absolute inset-0 bg-linear-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none'
          ></div>
        </div>
      </div>
      <div class='w-full md:w-1/2 md:max-w-lg flex flex-col justify-center'>
        <h3 class='text-2xl font-bold text-primary'>{name}</h3>
        <p class='mt-3 text-muted-foreground text-pretty'>{description}</p>
        <footer class='flex items-center mt-4 gap-x-4'>
          {github && (
            <Button href={github} variant='outline' target='_blank' rel='noopener noreferrer'>
              <GitHubIcon class='dark:invert' /> Código
            </Button>
          )}
          {link && (
            <Button href={link} variant='outline' target='_blank' rel='noopener noreferrer'>
              <ExternalLinkIcon /> Ver proyecto
            </Button>
          )}
        </footer>
      </div>
    </article>
  ))}
</div>
